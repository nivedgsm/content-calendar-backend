generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  TEAM_MEMBER
  CLIENT
}
enum ContentType {
  POST
  REEL
  CAROUSEL
  STORY
  VIDEO
}
enum ContentStatus {
  IDEA
  PLANNED
  IN_PRODUCTION
  READY
  FOR_REVIEW
  APPROVED
  CHANGES_REQUESTED
  PUBLISHED
}
enum Platform {
  INSTAGRAM
  FACEBOOK
  YOUTUBE
  LINKEDIN
  TIKTOK
}
enum ApprovalStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

model User {
  id             String         @id @default(cuid())
  name           String
  email          String         @unique
  passwordHash   String
  role           Role           @default(TEAM_MEMBER)
  agencyId       String
  agency         Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  clientId       String?
  client         Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  refreshTokens  RefreshToken[]
  assignedContent Content[]     @relation("ContentAssignee")
  approvals      Approval[]
  notifications  Notification[]
  memberships    ClientMember[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  @@index([agencyId, role])
  @@map("users")
}

model Agency {
  id        String   @id @default(cuid())
  name      String
  users     User[]
  clients   Client[]
  holidays  AgencyHoliday[]
  createdAt DateTime @default(now())
}

model AgencyHoliday {
  id          String   @id @default(cuid())
  agencyId    String
  title       String
  date        DateTime
  description String?
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([agencyId, date])
  @@map("agency_holidays")
}

model Client {
  id         String    @id @default(cuid())
  name       String
  brandName  String?
  industry   String?
  email      String?
  phone      String?
  color      String    @default("#7567F8")
  notes      String?
  agencyId   String
  agency     Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  users      User[]
  contents   Content[]
  shoots     Shoot[]
  marketingActivities MarketingActivity[]
  memberships ClientMember[]
  calendars Calendar[]
  templates Template[]
  colorPalettes ColorPalette[]
  calendarShares CalendarShare[]
  shareToken String?   @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  @@index([agencyId])
  @@map("clients")
}

model Content {
  id           String        @id @default(cuid())
  title        String
  description  String?
  caption      String?
  date         DateTime
  type         ContentType
  platform     Platform      @default(INSTAGRAM)
  status       ContentStatus @default(PLANNED)
  theme        String?
  referenceUrl String?
  mediaUrl     String?
  notes        String?
  clientId     String
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assigneeId   String?
  assignee     User?         @relation("ContentAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  approvals    Approval[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  @@index([clientId, date])
  @@index([status])
}

model Shoot {
  id        String   @id @default(cuid())
  title     String
  date      DateTime
  startTime String?
  endTime   String?
  location  String?
  crew      String?
  shotList  String?
  notes     String?
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([clientId, date])
}

model MarketingActivity {
  id             String   @id @default(cuid())
  clientId       String
  creativeName   String
  platform       String   @default("META")
  uploadedAt     DateTime
  spendRupees    Decimal  @default(0) @db.Decimal(12, 2)
  takenDownAt    DateTime?
  imageUrl       String?
  imagePublicId  String?
  notes          String?
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([clientId, uploadedAt])
  @@index([takenDownAt])
  @@map("marketing_activities")
}

model Approval {
  id         String         @id @default(cuid())
  status     ApprovalStatus @default(PENDING)
  comment    String?
  contentId  String
  content    Content        @relation(fields: [contentId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User           @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Calendar domain tables. Existing Agency/Content/Shoot models remain for the
// current API routes; these models provide the normalized calendar workspace.
model ClientMember {
  id        String   @id @default(cuid())
  clientId  String
  userId    String
  role      String   @default("MEMBER")
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([clientId, userId])
  @@index([userId])
  @@map("client_members")
}

model Calendar {
  id          String   @id @default(cuid())
  clientId    String
  name        String
  description String?
  design      Json     @default("{}") @db.JsonB
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items       ContentItem[]
  shares      CalendarShare[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([clientId])
  @@map("calendars")
}

model ContentItem {
  id          String   @id @default(cuid())
  calendarId  String
  title       String
  description String?
  caption     String?
  scheduledAt DateTime
  platform    String?
  status      String   @default("IDEA")
  presentation Json?   @db.JsonB
  internalNotes String?
  calendar    Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([calendarId, scheduledAt])
  @@map("content_items")
}

model Template {
  id        String   @id @default(cuid())
  clientId  String
  name      String
  config    Json     @default("{}") @db.JsonB
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([clientId])
  @@map("templates")
}

model ColorPalette {
  id        String   @id @default(cuid())
  clientId  String
  name      String
  colors    Json     @default("[]") @db.JsonB
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([clientId])
  @@map("color_palettes")
}

model CalendarShare {
  id         String    @id @default(cuid())
  calendarId String
  clientId   String
  token      String    @unique @default(uuid())
  isPublic   Boolean   @default(false)
  expiresAt  DateTime?
  calendar   Calendar  @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  @@index([clientId, isPublic])
  @@map("calendar_shares")
}
